{
  "name": "timbre-lossless-worker",
  "version": "1.0.0",
  "description": "Authenticated Cloudflare Worker and Telegram Bot for Timbre Hi-Res Lossless FLAC Addon",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute timbre-db --local --file=./schema.sql",
    "db:init-remote": "wrangler d1 execute timbre-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.50.0"
  }
}
